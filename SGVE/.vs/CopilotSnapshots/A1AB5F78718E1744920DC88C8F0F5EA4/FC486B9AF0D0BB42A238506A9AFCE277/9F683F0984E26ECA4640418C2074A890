        private void CargarProducto(int idProducto)
        {
            string valorparametro = idProducto.ToString();
            
            DataTable dt = cNProducto.ObtenerProducto(valorparametro);

            if (dt.Rows.Count == 0)
            {
                MessageBox.Show("Producto no encontrado.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            DataRow row = dt.Rows[0];

            int stockActual = Convert.ToInt32(row["StockUnidades"]);
            string nombre = row["Nombre"].ToString();
            decimal precio = Convert.ToDecimal(row["PrecioVenta"]);

            if (stockActual <= 0)
            {
                MessageBox.Show("No se pudo agregar el producto a la factura, no hay existencia.",
                                "No hay stock", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            bool encontrado = false;

            foreach (DataGridViewRow fila in dgDetalle.Rows)
            {
                if (fila.IsNewRow) continue;

                if (fila.Cells[0].Value != null &&
                    Convert.ToInt32(fila.Cells[0].Value) == idProducto)
                {
                    int cantidadActual = Convert.ToInt32(fila.Cells[3].Value);

                    if (cantidadActual >= stockActual)
                    {
                        MessageBox.Show("No se puede agregar más cantidad, ya alcanzaste el stock disponible.",
                                        "Stock insuficiente", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        return;
                    }

                    cantidadActual++;

                    fila.Cells[3].Value = cantidadActual;
                    fila.Cells[5].Value = cantidadActual * precio;
                    fila.Cells[6].Value = stockActual - cantidadActual;

                    encontrado = true;
                    break;
                }
            }

            if (!encontrado)
            {
                int cantidadInicial = 1;
                int stockTemporal = stockActual - cantidadInicial;
                decimal importe = cantidadInicial * precio;

                dgDetalle.Rows.Add(new object[]
                {
                    idProducto,              // 0
                    indexPro.ToString(),     // 1
                    nombre,                  // 2
                    cantidadInicial,         // 3
                    precio,                  // 4
                    importe,                 // 5
                    stockTemporal            // 6
                });

                indexPro++;
            }
        }

        private void tbProducto_KeyDown_1(object sender, KeyEventArgs e)
        {
            if (e.KeyCode == Keys.Enter)
