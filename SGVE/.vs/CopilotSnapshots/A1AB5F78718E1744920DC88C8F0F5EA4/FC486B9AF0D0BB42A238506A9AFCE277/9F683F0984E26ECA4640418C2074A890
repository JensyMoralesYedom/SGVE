                int idProductoSeleccionado = Program.vidProducto;
                // Aquí puedes cargar los detalles del producto seleccionado en los campos correspondientes

                CargarProducto(idProductoSeleccionado);
            }
        }

        private void btnFacturar_Click(object sender, EventArgs e)
        {
            // Validar que hay detalles para facturar
            if (dgDetalle.Rows.Count == 0 || (dgDetalle.Rows.Count == 1 && dgDetalle.Rows[0].IsNewRow))
            {
                MessageBox.Show("Debe agregar al menos un producto a la factura.", "Advertencia", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            // 🔴 1. VALIDAR TODO PRIMERO
            foreach (DataGridViewRow fila in dgDetalle.Rows)
            {
                if (fila.IsNewRow) continue;

                int idProducto = Convert.ToInt32(fila.Cells[0].Value);
                int cantidad = Convert.ToInt32(fila.Cells[3].Value);

                DataTable dt = cNProducto.ObtenerProducto(idProducto.ToString());

                if (dt.Rows.Count == 0)
                {
                    MessageBox.Show("Producto no encontrado en BD");
                    return;
                }

                int stockBD = Convert.ToInt32(dt.Rows[0]["StockUnidades"]);

                if (cantidad > stockBD)
                {
                    MessageBox.Show("Stock insuficiente al momento de facturar");
                    return;
                }
            }

            // 🟢 2. INSERTAR FACTURA (solo si todo pasó)
            CDResultado resultado = CNFacturas.Insertar(Program.vidCliente, Program.idUsuarioActual, DateTime.Now, "Activo", "", DateTime.Now);

            // Validar que la factura se insertó correctamente
            if (!resultado.Exito || resultado.IdResult <= 0)
            {
                MessageBox.Show("Error al insertar la factura: " + resultado.Msg, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            // 🟢 3. INSERTAR DETALLES Y ACTUALIZAR STOCK
            bool hayErrorEnDetalle = false;
            string mensajeError = "";

            foreach (DataGridViewRow fila in dgDetalle.Rows)
            {
                if (fila.IsNewRow) continue;

                int idProducto = Convert.ToInt32(fila.Cells[0].Value);
                int cantidad = Convert.ToInt32(fila.Cells[3].Value);

                DataTable dt = cNProducto.ObtenerProducto(idProducto.ToString());
                DataRow row = dt.Rows[0];

                int stockBD = Convert.ToInt32(row["StockUnidades"]);
                int nuevoStock = stockBD - cantidad;

                // Actualizar stock
                CNProducto.Actualizar(
                    idProducto,
                    row["Codigo"].ToString(),
                    row["Nombre"].ToString(),
                    row["Marca"].ToString(),
                    row["Descripcion"].ToString(),
                    Convert.ToDecimal(row["CostoPorUnidad"]),
                    Convert.ToDecimal(row["MililitrosPorUnidad"]),
                    Convert.ToDecimal(row["PrecioVenta"]),
                    Convert.ToInt32(row["IdCategoria"]),
                    nuevoStock, 
                    row["Estado"].ToString(),
                    Convert.ToInt32(row["IdUsuarioRegistro"])
                );

                // Insertar detalle de factura
                string resultadoDetalle = CNDetalleFactura.Insertar(
                    0, // IdDetalle (se autogenera en BD)
                    resultado.IdResult, // IdFactura
                    idProducto,
                    cantidad,
                    Convert.ToDecimal(row["PrecioVenta"])
                );

                // Validar resultado del detalle
                if (resultadoDetalle != "OK")
                {
                    hayErrorEnDetalle = true;
                    mensajeError = "Error al insertar detalle del producto " + row["Nombre"].ToString() + ": " + resultadoDetalle;
                    break;
                }
            }

            // Mostrar resultado
            if (hayErrorEnDetalle)
            {
                MessageBox.Show(mensajeError, "Error en detalle", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            else
            {
                MessageBox.Show("Factura realizada correctamente", "Éxito", MessageBoxButtons.OK, MessageBoxIcon.Information);
                // Limpiar el grid después de facturar exitosamente
                dgDetalle.Rows.Clear();
                indexPro = 1;
            }
        }

